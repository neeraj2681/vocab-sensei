# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Database password (any long random string): `openssl rand -base64 24`
POSTGRES_PASSWORD=

# The public address, used in email links (your tunnel's URL)
VOCAB_EMAIL__APP_BASE_URL=https://vocab.example.com

# Real email so friends can verify their accounts. Gmail: turn on 2-step verification, then
# create an app password at https://myaccount.google.com/apppasswords
VOCAB_EMAIL__SMTP_HOST=smtp.gmail.com
VOCAB_EMAIL__SMTP_PORT=587
VOCAB_EMAIL__SMTP_STARTTLS=true
VOCAB_EMAIL__SMTP_USERNAME=you@gmail.com
VOCAB_EMAIL__SMTP_PASSWORD=
VOCAB_EMAIL__FROM_ADDRESS=Vocab Sensei <you@gmail.com>

# Only for `--profile tunnel` (a fixed URL): the token from Cloudflare Zero Trust → Networks →
# Tunnels → Create a tunnel → Docker
TUNNEL_TOKEN=
