# One address for everything: the React app, with /api forwarded to the backend.
# HTTPS comes from the tunnel in front (Tailscale Funnel or Cloudflare), so Caddy itself serves
# plain HTTP inside Docker.
{
	servers {
		# The tunnel reaches Caddy from this Mac / the Docker network. Trust its X-Forwarded-For,
		# so the API sees each visitor's real address (rate limits are per visitor).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Build files have a hash in their names, so they can be kept for good; everything else
		# (index.html, the service worker, icons) is checked again, so updates show up at once.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html  # client-side routes like /quiz load the app
		file_server
	}
}
