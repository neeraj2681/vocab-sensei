# Copy to backend/.env (git-ignored). Every setting is optional; defaults suit local development.

# VOCAB_DATABASE_URL=sqlite:////absolute/path/to/vocab_sensei.db

# Real email via Gmail (needs 2-step verification + an app password)
# VOCAB_EMAIL__SMTP_HOST=smtp.gmail.com
# VOCAB_EMAIL__SMTP_PORT=587
# VOCAB_EMAIL__SMTP_STARTTLS=true
# VOCAB_EMAIL__SMTP_USERNAME=you@gmail.com
# VOCAB_EMAIL__SMTP_PASSWORD=your-app-password
# VOCAB_EMAIL__FROM_ADDRESS=Vocab Sensei <you@gmail.com>
# VOCAB_EMAIL__APP_BASE_URL=http://localhost:5173

# Behind HTTPS, mark the session cookie Secure
# VOCAB_AUTH__COOKIE_SECURE=true
